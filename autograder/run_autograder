#!/usr/bin/env bash
# Gradescope runs this for every submission. Results go to /autograder/results/results.json.
# AUTOGRADER_ROOT and AG_PYTHON let tests/run_local.sh run it outside Gradescope.
ROOT="${AUTOGRADER_ROOT:-/autograder}"
cd "$ROOT/source/grader"
exec "${AG_PYTHON:-python3}" grade.py --submission "$ROOT/submission" --results "$ROOT/results/results.json"
